# Application Environment
APP_ENV=production
PORT=8080

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=cbs_user
DB_PASSWORD=your_secure_db_password_here
DB_NAME=cbs_db
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Session cookies (httpOnly). Override bila perlu selaras dengan domain deployment.
CBS_ACCESS_COOKIE=cbs_access_token
CBS_REFRESH_COOKIE=cbs_refresh_token
# Cookie ini TIDAK httpOnly agar JS bisa mengirim header X-CSRF-Token (double-submit).
CBS_CSRF_COOKIE=csrf_token
CBS_CSRF_HEADER=X-CSRF-Token
# Opsional: set ".domain.tld" bila web & API di subdomain berbeda agar cookie dibagi.
# CBS_COOKIE_DOMAIN=
# CORS: daftar origin eksplisit (dipisah koma). Wildcard ditolak karena AllowCredentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limit login (in-memory per proses, tidak berlaku lintas instance).
# Hanya percobaan gagal (401) yang dihitung; login berhasil mereset kuota akun.
LOGIN_RATE_LIMIT_ACCOUNT_MAX=5
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW=15m
LOGIN_RATE_LIMIT_IP_MAX=20
LOGIN_RATE_LIMIT_IP_WINDOW=15m

# Next.js Backoffice
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Nama cookie CSRF yang dibaca web (samakan dengan CBS_CSRF_COOKIE).
NEXT_PUBLIC_CSRF_COOKIE=csrf_token
