# Contoh env untuk cbs-api (Core Banking System API Engine).
# Salin ke server sebagai /srv/qouver/apps/cbs/env/cbs-prod.env (mode 600).
# JANGAN commit nilai asli.

APP_ENV=production
PORT=8080

# PostgreSQL (container qouver-postgres, schema/DB cbs)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=cbs
DB_PASSWORD=CHANGE_ME
DB_NAME=cbs
DB_SSLMODE=disable

# Redis (opsional bila dipakai)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Kriptografi
JWT_SECRET=CHANGE_ME
ENCRYPTION_MASTER_KEY=CHANGE_ME
ENCRYPTION_KEY_ID=1
