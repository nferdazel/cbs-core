# Quadlet unit for CBS Core API
# Copy to VPS: ~/.config/containers/systemd/cbs-api.container
# Reload: systemctl --user daemon-reload && systemctl --user enable --now cbs-api

[Unit]
Description=CBS Core Banking System API Engine
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/cbs-api:local
ContainerName=cbs-api
Network=qouver
PublishPort=127.0.0.1:8095:8080
EnvironmentFile=/srv/qouver/cbs/env/cbs-prod.env
Pull=never

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
